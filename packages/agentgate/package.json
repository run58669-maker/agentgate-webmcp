{
  "name": "agentgate",
  "version": "0.1.0",
  "description": "A protocol layer on top of WebMCP: describe_page, structured receipts, risk tiers, request_human confirmation, and ready gating for agent-facing web tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/agentgate.mjs",
  "module": "./dist/agentgate.mjs",
  "types": "./dist/agentgate.d.ts",
  "unpkg": "./dist/agentgate.js",
  "exports": {
    ".": {
      "types": "./dist/agentgate.d.ts",
      "import": "./dist/agentgate.mjs",
      "default": "./dist/agentgate.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
